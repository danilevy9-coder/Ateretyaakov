# ─────────────────────────────────────────────────────────────
# Ateret Yaakov CRM — environment variables
# Copy this file to ".env.local" and fill in the values.
# NEVER commit .env.local (it is gitignored).
# In production, set these same vars in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────

# ── Supabase (new project — Settings → API) ──
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET — server only. Bypasses row-level security. Never expose to the browser:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Resend (email) — resend.com → API Keys ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" address must be on a domain you verified in Resend:
RESEND_FROM_EMAIL=Yeshiva Ateret Yaakov <donations@yourdomain.org>
# Where replies should go (your inbox):
RESEND_REPLY_TO=rabbig@lchaimcenter.org

# ── Claude API (AI spreadsheet import) — console.anthropic.com ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── CRM admin (the one account allowed to log in) ──
# Used only by the one-time seed script to create your login.
CRM_ADMIN_EMAIL=rabbig@lchaimcenter.org
