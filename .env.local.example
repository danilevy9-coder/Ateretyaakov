# ─────────────────────────────────────────────────────────────
# Ateret Yaakov CRM — environment variables
# Copy this file to ".env.local" and fill in the values.
# NEVER commit .env.local (it is gitignored).
# In production, set these same vars in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────

# ── Supabase (new project — Settings → API) ──
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET — server only. Bypasses row-level security. Never expose to the browser:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Resend (email) — resend.com → API Keys ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" address must be on a domain you verified in Resend:
RESEND_FROM_EMAIL=Yeshiva Ateret Yaakov <donations@yourdomain.org>
# Where replies should go (your inbox):
RESEND_REPLY_TO=rabbig@lchaimcenter.org

# ── Claude API (AI spreadsheet import) — console.anthropic.com ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── CRM admin (the one account allowed to log in) ──
# Used only by the one-time seed script to create your login.
# Also the recipient of the weekly Nedarim report (unless NEDARIM_REPORT_EMAIL is set).
CRM_ADMIN_EMAIL=rabbig@lchaimcenter.org

# ── Nedarim Plus (automated standing-order sync) ──
# 7-digit mosad number + API password. To get the password, email office@nedar.im
# FROM AN EMAIL AUTHORIZED ON THE MOSAD and ask for "סיסמת API למשיכת נתונים".
NEDARIM_MOSAD_ID=1234567
NEDARIM_API_PASSWORD=xxxxxxxx
# Long random string; Vercel sends it with cron requests (Settings → Environment Variables).
CRON_SECRET=generate-a-long-random-string
# Optional overrides:
# NEDARIM_REPORT_EMAIL=            # weekly digest recipient (defaults to CRM_ADMIN_EMAIL)
# NEDARIM_DONATE_URL=              # re-donate link in recovery emails (default: site /support)
# NEDARIM_REMINDER_DAYS=7          # days between reminder emails
# NEDARIM_MAX_NOTICES=3            # max automated emails per bouncing donor
# NEDARIM_REPORT_WEEKDAY=0         # weekly digest day, 0=Sunday
# NEDARIM_MOCK=1                   # test fixtures without credentials (1=bouncing, 2=recovered)
